{
  "permissions": {
    "allow": ["Bash(pnpm fsd:lint*)", "Bash(pnpm fsd:watch*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/superpowers-session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm -s fsd:lint 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
